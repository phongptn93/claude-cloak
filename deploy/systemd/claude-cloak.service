# Native deployment: the proxy binds 443 itself and terminates TLS in-process.
# No reverse proxy is involved, so every IP gate still sees the real client
# address rather than a loopback hop.
#
#   sudo deploy/systemd/install.sh
[Unit]
Description=Claude Cloak proxy
Documentation=https://github.com/phongptn93/claude-cloak
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=claude-cloak
Group=claude-cloak
WorkingDirectory=/var/lib/claude-cloak
Environment=CLAUDE_CLOAK_ENV=/var/lib/claude-cloak/.env
ExecStart=/opt/claude-cloak/.venv/bin/claude-cloak

Restart=always
RestartSec=5s
# Counters are flushed to disk in the lifespan shutdown hook; give it room.
TimeoutStopSec=20s
KillSignal=SIGINT

# Binding 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Identity capture writes CAPTURED_* back into .env, and the quota/coach
# counters persist next to it. Certificates are published into the same
# directory by the certbot deploy hook, so /etc/letsencrypt stays out of
# reach of the service entirely.
ReadWritePaths=/var/lib/claude-cloak

StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-cloak

[Install]
WantedBy=multi-user.target
