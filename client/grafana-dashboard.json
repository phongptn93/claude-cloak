{
  "annotations": {
    "list": [
      {
        "datasource": "Loki",
        "enable": true,
        "iconColor": "yellow",
        "name": "Identity captured",
        "target": {
          "datasource": "Loki",
          "expr": "{job=\"$job\", host=~\"$host\", event=\"identity\"}",
          "refId": "Anno"
        },
        "titleFormat": "Identity captured on {{host}}"
      }
    ]
  },
  "description": "Claude Cloak — multi-device proxy: cost, tokens, sessions, rate limits, errors, and telemetry blocking.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Claude Cloak repo",
      "url": "https://github.com/phongptn93/claude-cloak",
      "type": "link",
      "icon": "external link",
      "tags": []
    }
  ],
  "liveNow": false,
  "tags": ["claude", "claude-cloak", "anthropic", "ai-cost", "loki"],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "constant",
        "query": "claude-cloak",
        "current": {"text": "claude-cloak", "value": "claude-cloak", "selected": true},
        "hide": 2
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({job=\"$job\"}, host)",
        "current": {"text": "All", "value": "$__all"},
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": "Loki",
        "query": "label_values({job=\"$job\", host=~\"$host\"}, model)",
        "current": {"text": "All", "value": "$__all"},
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 100,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "datasource": "Loki",
      "type": "stat",
      "title": "Total Cost",
      "description": "Sum of cost_usd from successful /v1/messages calls in range",
      "id": 1,
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap cost_usd [$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "blue"},
              {"value": 1, "color": "green"},
              {"value": 25, "color": "yellow"},
              {"value": 100, "color": "orange"},
              {"value": 500, "color": "red"}
            ]
          },
          "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "$0"}}}]
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "datasource": "Loki",
      "type": "stat",
      "title": "Requests",
      "description": "Successful /v1/messages calls in range",
      "id": 2,
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 1},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(count_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} [$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "blue"},
              {"value": 100, "color": "green"},
              {"value": 1000, "color": "yellow"},
              {"value": 5000, "color": "orange"}
            ]
          },
          "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "0"}}}]
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "datasource": "Loki",
      "type": "stat",
      "title": "Total Tokens",
      "description": "input + output + cache_read + cache_creation",
      "id": 3,
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 1},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap estimated_tokens [$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "blue"},
              {"value": 100000, "color": "green"},
              {"value": 1000000, "color": "yellow"},
              {"value": 10000000, "color": "orange"}
            ]
          },
          "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "0"}}}]
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "datasource": "Loki",
      "type": "stat",
      "title": "Avg Cost / Request",
      "id": 4,
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 1},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap cost_usd [$__range])) / clamp_min(sum(count_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"}[$__range])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 0.05, "color": "yellow"},
              {"value": 0.25, "color": "orange"},
              {"value": 1, "color": "red"}
            ]
          },
          "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "—"}}}]
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "datasource": "Loki",
      "type": "stat",
      "title": "Active Sessions",
      "description": "Distinct conversation_id values seen in range",
      "id": 5,
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 1},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "count(count by (conversation_id) (count_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | conversation_id != \"\" [$__range])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "purple"},
              {"value": 2, "color": "blue"},
              {"value": 10, "color": "green"}
            ]
          },
          "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "0"}}}]
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "datasource": "Loki",
      "type": "stat",
      "title": "Active Hosts",
      "description": "Distinct devices/hosts using the proxy",
      "id": 6,
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 1},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "count(count by (host) (count_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"}[$__range])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
