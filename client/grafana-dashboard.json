              {"value": null, "color": "blue"},
              {"value": 1, "color": "green"}
            ]
          },
          "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "0"}}}]
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },

    {
      "type": "row",
      "title": "Cost & Volume Trends",
      "id": 101,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "collapsed": false
    },
    {
      "datasource": "Loki",
      "type": "timeseries",
      "title": "Cost Over Time (by model)",
      "description": "Stacked USD spend per interval, broken down by model",
      "id": 10,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum by (model) (sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap cost_usd [$__interval]))",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {"mode": "normal", "group": "A"}
          },
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum", "mean"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "datasource": "Loki",
      "type": "timeseries",
      "title": "Token Throughput (input vs output vs cache)",
      "description": "Token rate per interval, broken into input / output / cache_read / cache_creation",
      "id": 11,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap input_tokens [$__interval]))",
          "refId": "A",
          "legendFormat": "input"
        },
        {
          "datasource": "Loki",
          "expr": "sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap output_tokens [$__interval]))",
          "refId": "B",
          "legendFormat": "output"
        },
        {
          "datasource": "Loki",
          "expr": "sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap cache_read_tokens [$__interval]))",
          "refId": "C",
          "legendFormat": "cache_read"
        },
        {
          "datasource": "Loki",
          "expr": "sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap cache_creation_tokens [$__interval]))",
          "refId": "D",
          "legendFormat": "cache_creation"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {"mode": "none", "group": "A"}
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "input"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
          {"matcher": {"id": "byName", "options": "output"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
          {"matcher": {"id": "byName", "options": "cache_read"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}]},
          {"matcher": {"id": "byName", "options": "cache_creation"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum", "mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "datasource": "Loki",
      "type": "timeseries",
      "title": "Requests / Minute (by host)",
      "description": "Per-host request rate — shows when each device is active",
      "id": 12,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum by (host) (rate({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"}[$__interval])) * 60",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "datasource": "Loki",
      "type": "timeseries",
      "title": "Latency (p50 / p95 / max)",
      "description": "End-to-end /v1/messages duration, percentiles per interval",
      "id": 13,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "quantile_over_time(0.5, {job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap duration_ms [$__interval])",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "datasource": "Loki",
          "expr": "quantile_over_time(0.95, {job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap duration_ms [$__interval])",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "datasource": "Loki",
          "expr": "max_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap duration_ms [$__interval])",
          "refId": "C",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },

