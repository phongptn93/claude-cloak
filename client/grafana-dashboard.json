    {
      "type": "row",
      "title": "Cache & Efficiency",
      "id": 103,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 35},
      "collapsed": false
    },
    {
      "datasource": "Loki",
      "type": "stat",
      "title": "Cache Hit Rate",
      "description": "cache_read_tokens / (input_tokens + cache_read_tokens) — higher is cheaper",
      "id": 30,
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 36},
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap cache_read_tokens [$__range])) / clamp_min(sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap input_tokens [$__range])) + sum(sum_over_time({job=\"$job\", host=~\"$host\", event=\"usage\", model=~\"$model\"} | json | unwrap cache_read_tokens [$__range])), 1) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 30, "color": "orange"},
              {"value": 60, "color": "yellow"},
              {"value": 80, "color": "green"}
            ]
          },
          "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "—"}}}]
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
