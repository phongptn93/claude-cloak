# === CLAUDE CLOAK CONFIG ===
LOCAL_PORT=9999

# === DEPLOY MODE ===
# local  — bind 127.0.0.1, no IP whitelist, identity auto-captured on first
#          request. One proxy per device. This is the original behaviour.
# server — bind LOCAL_HOST (default 0.0.0.0) so other machines can reach this
#          VM. Requires ALLOWED_IPS to be set or boot is aborted. Identity
#          auto-capture is disabled (pre-populate CAPTURED_* below).
DEPLOY_MODE=local
# LOCAL_HOST=0.0.0.0   # override bind address; defaults follow DEPLOY_MODE

# === IP WHITELIST (server mode only) ===
# Comma-separated list of IPs and/or CIDR blocks (v4 + v6). Only requests
# whose TCP source matches one of these entries are accepted in server mode.
# Local mode ignores this entirely.
# Example: ALLOWED_IPS=203.0.113.5,198.51.100.0/24,2001:db8::/32
ALLOWED_IPS=
# Admin-only endpoints (POST /admin/quota/reset/{label}) additionally require
# the caller to come from one of these IPs. Defaults to loopback so curling
# from the VM itself works while remote whitelisted clients can't reset caps.
# ADMIN_IPS=127.0.0.1,::1

# === IP → USER LABEL MAP ===
# Used by the dashboard and per-user quota. Unmapped IPs show up as the raw
# IP string. Format: <ip>:<label>,<ip>:<label>,...
# Example: IP_LABELS=203.0.113.5:phong,198.51.100.7:huy,198.51.100.8:minh
IP_LABELS=

# === PER-USER QUOTA (server mode) ===
# Caps USD spend per user (resolved from IP_LABELS). When a user is over the
# cap and USER_QUOTA_HARD_LIMIT=true, /v1/* requests return 429 until the
# next period boundary. Set USER_QUOTA_DEFAULT_USD=0 to make unmapped IPs
# unlimited (still tracked).
USER_QUOTA_ENABLED=false
USER_QUOTA_PERIOD=monthly        # monthly | daily
USER_QUOTA_DEFAULT_USD=20.0
USER_QUOTA_HARD_LIMIT=true
# Per-label overrides (USD). Example: USER_QUOTA_CAPS=phong:50.0,huy:30.0
USER_QUOTA_CAPS=

# === HARDENING (server mode, optional) ===
# Restrict identity capture to one specific source IP — only that IP's first
# /v1/messages request can lock the device fingerprint for the whole pool.
# Empty = any whitelisted caller may be the first-capturer.
# CAPTURE_LOCK_FROM_IP=10.0.0.5

# Gate stats endpoints (/health, /quota, /quota/users, /dashboard) to a
# trusted-admin IP set. When false (default), every whitelisted client can
# see total spend + per-user costs on the dashboard. Set true if you don't
# want users to see each other's spending.
STATS_PRIVATE=false
# IPs allowed to view stats when STATS_PRIVATE=true. Defaults to ADMIN_IPS.
# STATS_VIEW_IPS=127.0.0.1,::1,10.0.0.10

# === ANONYMITY SETTINGS ===
# Timing jitter to mask multi-device patterns (true/false)
TIMING_JITTER=true
# Jitter range in milliseconds
TIMING_JITTER_MIN_MS=10
TIMING_JITTER_MAX_MS=150

# === TOKEN SAVER (optional) ===
# Reduce input token cost on /v1/messages without changing semantics.
# Master switch — set to true to enable.
TOKEN_SAVER=false
# Bump prompt-cache TTL from 5m to 1h on system + last tool definition.
# Auto-appends `extended-cache-ttl-2025-04-11` Anthropic beta header.
# Auto-disables on first 400 response that mentions the beta (graceful fallback).
# Respects Anthropic's 4-breakpoint cap — never adds a new breakpoint when full.
CACHE_EXTEND_TTL=true
# Head+tail truncate large tool_result blocks in older turns.
# Default OFF: small risk of breaking agent loops if Claude needs to re-read
# a truncated old output. Turn on when running multi-device or long sessions.
TOOL_RESULT_TRUNCATE=false
# Truncate threshold + head/tail sizes (chars) and how many recent turns to keep intact.
TOOL_RESULT_MAX_BYTES=8000
TOOL_RESULT_HEAD_BYTES=4000
TOOL_RESULT_TAIL_BYTES=2000
TOOL_RESULT_KEEP_RECENT=2

# === QUOTA / COST TRACKING ===
# Parse anthropic-ratelimit-* headers and `usage` from /v1/messages responses
# to surface live remaining quota + accumulated cost.
# Read via GET /quota (JSON) or GET /dashboard (web UI with charts).
QUOTA_TRACKING=true
# Persist accumulated counters to .quota.json next to .env so totals survive
# proxy restarts. Writes are debounced (default: at most every 30s) plus a
# forced flush on shutdown. Set QUOTA_PERSIST_INTERVAL=0 to write on every
# response (slower disk I/O but never lose data on hard kill).
QUOTA_PERSIST_INTERVAL=30
# QUOTA_PERSIST_PATH=  # default: .quota.json next to .env
# Caps to prevent unbounded growth — oldest entries evicted when exceeded.
QUOTA_MAX_SESSIONS=100
QUOTA_MAX_DAYS=30
# Auto-reset cost/token totals at the start of each calendar month.
# by_day history is always kept so the trend chart spans multiple months.
QUOTA_MONTHLY_RESET=true
# Override per-million-token USD prices if Anthropic's list prices change.
# Format: PRICING_<MODEL_KEY>_<TIER>=<usd>
# Model keys: OPUS_4, SONNET_4, HAIKU_4, OPUS_3, SONNET_3_7, SONNET_3_5, HAIKU_3_5, HAIKU_3
# Tiers: INPUT, OUTPUT, CACHE_WRITE_5M, CACHE_WRITE_1H, CACHE_READ
# Example:
# PRICING_SONNET_4_INPUT=3.00
# PRICING_SONNET_4_OUTPUT=15.00

# === LOKI LOG SHIPPING (optional) ===
# Forward usage / error / blocked / identity events to a Grafana Loki
# endpoint. Disabled by default — fill LOKI_URL to enable.
# Bundled Grafana dashboard: client/grafana-dashboard.json
# LOKI_URL=http://192.168.15.120:3100/loki/api/v1/push
# LOKI_JOB=claude-cloak
# LOKI_HOST=  # default: socket.gethostname()
# LOKI_USER_EMAIL=  # optional, becomes a label if set
# LOKI_LABELS=team=eng,env=dev  # optional extra static labels
# LOKI_BATCH_SIZE=100
# LOKI_FLUSH_INTERVAL=5
# LOKI_MAX_BUFFER=2000
# LOKI_TIMEOUT=10

# === IDENTITY REFRESH ===
# Auto-clear the locked fingerprint after N days, so the next legit
# /v1/messages request from claude-cli re-captures fresh device headers.
# Set 0 to lock indefinitely (original behaviour). Default 14 days.
IDENTITY_REFRESH_DAYS=14
# Auto-written on every capture; do not edit by hand. Empty string in a
# legacy .env means "no age info" — the next capture will stamp it.
CAPTURED_AT=

# === SESSION SECRET ===
# Consistent ID generation across devices (auto-generated on first capture)
SESSION_SECRET=

# === CAPTURED IDENTITY (auto-filled on first request) ===
CAPTURED_USER_AGENT=
CAPTURED_X_CLAUDE_CODE_SESSION_ID=
CAPTURED_X_APP=
CAPTURED_ANTHROPIC_BETA=
CAPTURED_ANTHROPIC_VERSION=
CAPTURED_ANTHROPIC_DANGEROUS_DIRECT_BROWSER_ACCESS=
CAPTURED_X_STAINLESS_OS=
CAPTURED_X_STAINLESS_ARCH=
CAPTURED_X_STAINLESS_RUNTIME=
CAPTURED_X_STAINLESS_RUNTIME_VERSION=
CAPTURED_X_STAINLESS_LANG=
CAPTURED_X_STAINLESS_PACKAGE_VERSION=
CAPTURED_X_STAINLESS_RETRY_COUNT=
CAPTURED_X_STAINLESS_READ_TIMEOUT=
CAPTURED_ACCEPT_ENCODING=
CAPTURED_ACCEPT_LANGUAGE=
CAPTURED_SEC_FETCH_MODE=
CAPTURED_SEC_FETCH_SITE=
CAPTURED_SEC_FETCH_DEST=
CAPTURED_ORIGIN=
CAPTURED_REFERER=
CAPTURED_X_CLIENT_VERSION=
CAPTURED_X_CLIENT_NAME=
