# === CLAUDE CLOAK CONFIG ===
LOCAL_PORT=9999

# === ANONYMITY SETTINGS ===
# Timing jitter to mask multi-device patterns (true/false)
TIMING_JITTER=true
# Jitter range in milliseconds
TIMING_JITTER_MIN_MS=10
TIMING_JITTER_MAX_MS=150

# === TOKEN SAVER (optional) ===
# Reduce input token cost on /v1/messages without changing semantics.
# Master switch — set to true to enable.
TOKEN_SAVER=false
# Bump prompt-cache TTL from 5m to 1h on system + last tool definition.
# Auto-appends `extended-cache-ttl-2025-04-11` Anthropic beta header.
CACHE_EXTEND_TTL=true
# Head+tail truncate large tool_result blocks in older turns.
TOOL_RESULT_TRUNCATE=true
# Truncate threshold + head/tail sizes (chars) and how many recent turns to keep intact.
TOOL_RESULT_MAX_BYTES=8000
TOOL_RESULT_HEAD_BYTES=4000
TOOL_RESULT_TAIL_BYTES=2000
TOOL_RESULT_KEEP_RECENT=2

# === SESSION SECRET ===
# Consistent ID generation across devices (auto-generated on first capture)
SESSION_SECRET=

# === CAPTURED IDENTITY (auto-filled on first request) ===
CAPTURED_USER_AGENT=
CAPTURED_X_CLAUDE_CODE_SESSION_ID=
CAPTURED_X_APP=
CAPTURED_ANTHROPIC_BETA=
CAPTURED_ANTHROPIC_VERSION=
CAPTURED_ANTHROPIC_DANGEROUS_DIRECT_BROWSER_ACCESS=
CAPTURED_X_STAINLESS_OS=
CAPTURED_X_STAINLESS_ARCH=
CAPTURED_X_STAINLESS_RUNTIME=
CAPTURED_X_STAINLESS_RUNTIME_VERSION=
CAPTURED_X_STAINLESS_LANG=
CAPTURED_X_STAINLESS_PACKAGE_VERSION=
CAPTURED_X_STAINLESS_RETRY_COUNT=
CAPTURED_X_STAINLESS_READ_TIMEOUT=
CAPTURED_ACCEPT_ENCODING=
CAPTURED_ACCEPT_LANGUAGE=
CAPTURED_SEC_FETCH_MODE=
CAPTURED_SEC_FETCH_SITE=
CAPTURED_SEC_FETCH_DEST=
CAPTURED_ORIGIN=
CAPTURED_REFERER=
CAPTURED_X_CLIENT_VERSION=
CAPTURED_X_CLIENT_NAME=
